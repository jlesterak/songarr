SONGARR<__INSTANCE>__ENABLED='false'
SONGARR<__INSTANCE>__CONTAINER_NAME='songarr<__instance>'
SONGARR<__INSTANCE>__HOSTNAME='Songarr<__Instance>'
SONGARR<__INSTANCE>__NETWORK_MODE=''
SONGARR<__INSTANCE>__PORT_3001='3001'
SONGARR<__INSTANCE>__RESTART='unless-stopped'
SONGARR<__INSTANCE>__STORAGE_ON=''     # Blank uses DOCKER_STORAGE_ON value. Set to YES/NO to override
SONGARR<__INSTANCE>__STORAGE2_ON=''    # Blank uses DOCKER_STORAGE2_ON value. Set to YES/NO to override
SONGARR<__INSTANCE>__STORAGE3_ON=''    # Blank uses DOCKER_STORAGE3_ON value. Set to YES/NO to override
SONGARR<__INSTANCE>__STORAGE4_ON=''    # Blank uses DOCKER_STORAGE4_ON value. Set to YES/NO to override
SONGARR<__INSTANCE>__TAG='latest'
SONGARR<__INSTANCE>__VOLUME_MUSIC="${DOCKER_VOLUME_STORAGE?}/music"
