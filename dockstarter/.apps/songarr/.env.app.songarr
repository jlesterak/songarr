## Update yt-dlp at every container start. YouTube changes often enough that
## a few-weeks-old yt-dlp stops working; set to 'false' to keep the image's copy.
YTDLP_AUTOUPDATE='true'
## Optional login (HTTP Basic auth) for the web UI and API. Leave both empty to
## run without one, e.g. on a trusted LAN. The healthcheck is always open.
SONGARR_USERNAME=''
SONGARR_PASSWORD=''
